# 阿里云百炼 API 配置
# 必需: 从 https://dashscope.console.aliyun.com/ 获取 API Key
BAILIAN_API_KEY=your_api_key_here

# 运行环境
# 可选: development | production (默认: development)
NODE_ENV=development

# 服务器端口
# 可选: 默认 3000
PORT=3000

# 数据库功能
# 可选: true | false (默认: true，开发环境建议启用)
# 启用后会创建 SQLite 数据库记录 API 请求日志和会话状态
ENABLE_DATABASE=true

# Prompt 版本号
# 可选: 用于跟踪 prompt 改进效果 (默认: v1.0)
# 当修改 prompt 时，更新此版本号以便对比不同版本的效果
PROMPT_VERSION=v1.0
